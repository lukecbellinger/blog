   ========================================================================== */
/* ==========================================================================
   UPDATED FIX: Square Transparent Gray Box with Serif Typography
   ========================================================================== */
.quarto-title-block .quarto-title h1.title {
  display: inline-block !important;
  
  // Transparent gray background rectangle
  background-color: rgba(60, 60, 60, 0.75) !important; 
  
  // Explicitly forces square edges instead of rounded ones
  border-radius: 0px !important; 
  
  // Custom theme typography styling
  color: #D55E00 !important; 
  font-family: "lmroman", serif !important; // Changed to serif font choice
  text-transform: none !important;
  font-weight: 700; /* bold links */
  
  // Layout spacing adjustments
  padding: 10px 20px !important;
  margin: 0 !important;
}

/* ==========================================================================
   CATEGORY BUTTON STYLING
   ========================================================================== */
/* ==========================================================================
   UPDATED CATEGORY BUTTON STYLING
   ========================================================================== */
// Force parent wrappers to full opacity so the link properties are not washed out
.quarto-categories,
.quarto-category {
  opacity: 1 !important; 
}

// Target the link inside the category elements with your exact style values
.quarto-category a {
  display: inline-block !important;
  
  // High-contrast transparent gray background
  background-color: rgba(60, 60, 60, 0.75) !important;
  
  // Sizing and weight values
  font-size: 0.7rem !important; 
  font-weight: 700 !important; 
  
  // Theme coloring and layout filters
  color: #D55E00 !important; 
  opacity: 1 !important;
  
  // Structural choices to match previous steps (square edges and typography)
  font-family: "lmmono", serif !important; 
  text-transform: lowercase !important;
  text-decoration: none !important;
  border-radius: 0px !important;
  border: none !important;
  margin: 0px !important; 
}

// Clean hover matching the updated text color
.quarto-category a:hover {
  background-color: rgba(80, 80, 80, 0.5) !important;
  color: #D55E00 !important;
  opacity: 1 !important;
}
